# ---------------------------------------------------------------------------
# WACA Platform — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Local container Postgres 17. On Supabase this becomes the pooled/direct URL
# from Project Settings > Database (the "postgres" role connection string).
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/waca"
# Direct (non-pooled) connection used by drizzle-kit for migrations.
# On Supabase use the port 5432 direct URL, NOT the 6543 pgbouncer URL.
DIRECT_DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/waca"

# --- Auth.js v5 -----------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET="replace-me"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- Email (Resend, transactional only) -----------------------------------
AUTH_RESEND_KEY=""
RESEND_API_KEY=""
EMAIL_FROM="WACA <no-reply@example.org>"

# --- Supabase (not yet provisioned; names reserved so nothing renames later)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Private Storage bucket holding the document library. The portal never hands
# out an object URL directly: it mints a short-lived, viewer-bound token and
# the download route asks Storage for a signed, expiring URL. Defaults to
# "documents" when unset.
SUPABASE_DOCUMENTS_BUCKET=

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Surfaces the "DEMO DATA" banner in the UI. Set to "false" only once the
# real Wild Apricot import has replaced the synthetic seed.
NEXT_PUBLIC_IS_DEMO_DATA="true"

# --- Scheduled jobs -------------------------------------------------------
# Guards /api/cron/renewals, which raises invoices and emails members.
# Vercel Cron sends it as "Authorization: Bearer $CRON_SECRET".
# If this is unset the route returns 503 and does nothing, by design.
#   openssl rand -hex 32
CRON_SECRET=""
