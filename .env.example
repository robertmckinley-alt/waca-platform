# ---------------------------------------------------------------------------
# WACA Platform — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Local container Postgres 17. On Supabase this becomes the pooled/direct URL
# from Project Settings > Database (the "postgres" role connection string).
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/waca"
# Direct (non-pooled) connection used by drizzle-kit for migrations.
# On Supabase use the port 5432 direct URL, NOT the 6543 pgbouncer URL.
DIRECT_DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/waca"

# --- Auth.js v5 -----------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET="replace-me"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- Email ----------------------------------------------------------------
# Magic-link sign-in. Without it, magic-link login is disabled and says so.
AUTH_RESEND_KEY=""

# THE sending key, for BOTH transactional mail and campaigns. Unset means the
# whole application is in DRY RUN: bodies are rendered, recipient rows are
# written and statuses advance, but NOTHING is transmitted, and every screen
# says so. See docs/EMAIL-DELIVERABILITY.md.
RESEND_API_KEY=""
EMAIL_FROM="WACA <no-reply@example.org>"

# FORCE DRY RUN even with a key present. Set this on every staging and preview
# deployment. Any value other than false/0/no/off counts as on.
#   NOTE: NEXT_PUBLIC_IS_DEMO_DATA=true also forces dry run, independently.
EMAIL_DRY_RUN=""

# Signs the Resend webhook (delivered / opened / clicked / bounced /
# complained). Created with the endpoint in the Resend dashboard; looks like
# "whsec_...". WITHOUT IT /api/webhooks/resend RETURNS 503 AND REFUSES EVERY
# EVENT, so no bounce or complaint ever reaches the suppression list. That is
# deliberate: the endpoint is public and writes to a global block list.
RESEND_WEBHOOK_SECRET=""

# Optional. A real, monitored mailbox for the mailto: form of
# List-Unsubscribe. Leave unset rather than pointing it at an unattended
# address — the header is a promise of a working opt-out route.
EMAIL_UNSUBSCRIBE_MAILTO=""

# Optional pacing. Defaults: 2 messages/second, 2 in flight, 50 per batch.
# Resend's default account limit is 2/second; raise only if they have raised it.
EMAIL_RATE_PER_SECOND=""
EMAIL_CONCURRENCY=""
EMAIL_BATCH_SIZE=""

# --- Supabase (not yet provisioned; names reserved so nothing renames later)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Private Storage bucket holding the document library. The portal never hands
# out an object URL directly: it mints a short-lived, viewer-bound token and
# the download route asks Storage for a signed, expiring URL. Defaults to
# "documents" when unset.
SUPABASE_DOCUMENTS_BUCKET=

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Surfaces the "DEMO DATA" banner in the UI. Set to "false" only once the
# real Wild Apricot import has replaced the synthetic seed.
NEXT_PUBLIC_IS_DEMO_DATA="true"

# --- Scheduled jobs -------------------------------------------------------
# Guards /api/cron/renewals (invoices and reminders) AND
# /api/cron/email-dispatch (scheduled campaign sends).
# Vercel Cron sends it as "Authorization: Bearer $CRON_SECRET".
# If this is unset the route returns 503 and does nothing, by design.
#   openssl rand -hex 32
CRON_SECRET=""
